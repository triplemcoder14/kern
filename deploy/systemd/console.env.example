# KERN console environment — copy to /etc/kern/console.env
#
#   sudo cp deploy/systemd/console.env.example /etc/kern/console.env
#   sudo chmod 600 /etc/kern/console.env
#   sudo nano /etc/kern/console.env

# Console login (created on first API start when users.json is empty)
KERN_USERNAME=admin
KERN_PASSWORD=change-me-on-install

# Session signing secret — change in production
KERN_AUTH_SECRET=replace-with-a-long-random-string

# URL you open in the browser (CORS + cookies)
KERN_PUBLIC_ORIGIN=http://localhost:8080

# Web UI listen port (systemd native nginx)
KERN_CONSOLE_PORT=8080

# API listen port (systemd native; Docker uses internal networking)
KERN_API_PORT=3000

# Where the API reaches Kubernetes and the agent
KERN_K8S_PROXY=http://127.0.0.1:8001
KERN_EBPF_COLLECTOR=http://127.0.0.1:9474

# Persistence (systemd native)
KERN_DATA_DIR=/var/lib/kern/data
KERN_STORAGE_BACKEND=file

# GHCR image tag for install scripts (match a release tag without the v prefix)
KERN_VERSION=0.6.0
