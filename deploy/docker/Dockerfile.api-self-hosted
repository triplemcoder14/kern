FROM node:22-alpine AS build

WORKDIR /kern

COPY api/package.json api/package-lock.json ./api/
RUN npm ci --prefix api

COPY api/tsconfig.json api/tsconfig.build.json ./api/
COPY api/src ./api/src
COPY src/core ./src/core
COPY src/worker ./src/worker
COPY storage ./storage

# Shared src/ imports resolve from repo root (tsconfig baseUrl); api deps live under api/node_modules
RUN ln -s /kern/api/node_modules /kern/node_modules

RUN npm run build --prefix api

FROM node:22-alpine

WORKDIR /kern/api

ENV NODE_ENV=production
ENV KERN_DATA_DIR=/var/lib/kern/data

COPY api/package.json api/package-lock.json ./
RUN npm ci --omit=dev

COPY --from=build /kern/api/dist ./dist

EXPOSE 3000

CMD ["node", "dist/api/src/main.js"]
